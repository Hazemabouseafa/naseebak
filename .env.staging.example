# ==============================================================================
# نَصِيبُكَ (Naseebak) — Coolify Staging Stack Environment Configuration
# Location: Repository Root (.env.staging.example)
#
# Target Host: Hostinger VPS (187.126.13.178)
# Base Domain: hazem.my
# Staging API: https://naseebak-api.hazem.my
# Staging WebSockets: wss://naseebak-ws.hazem.my
# Filament Admin: https://naseebak-api.hazem.my/admin
#
# Instructions:
# Configure these environment variables in the Coolify UI under:
# Application (Naseebak-Staging) -> Configuration -> Environment Variables.
#
# DO NOT COMMIT REAL SECRETS OR CRYPTOGRAPHIC KEYS TO VERSION CONTROL.
# ==============================================================================

# Docker Image Tag
STAGING_IMAGE_TAG=v1.0.0-rc1

# Public Application Settings
STAGING_APP_ENV=staging
STAGING_APP_DEBUG=false
STAGING_APP_NAME=Naseebak
STAGING_APP_URL=https://naseebak-api.hazem.my
STAGING_ADMIN_URL=https://naseebak-api.hazem.my/admin

# Isolated PostgreSQL 16 Credentials (Internal Network Only)
STAGING_DB_DATABASE=naseebak_staging
STAGING_DB_USERNAME=naseebak_staging_user
STAGING_DB_PASSWORD=

# Laravel Cryptographic Key (Generate with: php artisan key:generate --show)
STAGING_APP_KEY=

# Laravel Reverb Real-Time WebSockets
STAGING_REVERB_APP_ID=
STAGING_REVERB_APP_KEY=
STAGING_REVERB_APP_SECRET=
STAGING_REVERB_PUBLIC_HOST=naseebak-ws.hazem.my
STAGING_REVERB_PUBLIC_SCHEME=https

# Official Google OAuth 2.0 Client IDs
STAGING_GOOGLE_ANDROID_CLIENT_ID=520721691788-0fki6oqjcsjtk6g9qbo2ean3fj3cpeq2.apps.googleusercontent.com
STAGING_GOOGLE_WEB_CLIENT_ID=520721691788-4ngp8rrm7g4foja1f3ql24bv2apdgcoo.apps.googleusercontent.com

# Google Play Billing (com.naseebak.app)
STAGING_GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
STAGING_GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership

# Firebase Cloud Messaging (Push Notifications ONLY)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# Web Payment Gateway (Paymob Sandbox — Web Only)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
