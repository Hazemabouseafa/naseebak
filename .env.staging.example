# ==============================================================================
# نَصِيبُكَ (Naseebak) — Coolify Staging Stack Environment Template
# Location: Repository Root (.env.staging.example)
#
# Instructions:
# Configure these environment variables in the Coolify UI under:
# Application (Naseebak-Staging) -> Configuration -> Environment Variables.
#
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL.
# ==============================================================================

# Docker Image Tag
STAGING_IMAGE_TAG=v1.0.0-rc1

# PostgreSQL Staging Credentials (Internal Isolated Container)
STAGING_DB_DATABASE=naseebak_staging
STAGING_DB_USERNAME=naseebak_staging_user
STAGING_DB_PASSWORD=

# Laravel Application Key (Generate using: php artisan key:generate --show)
STAGING_APP_KEY=

# Staging Application URL (Coolify Temporary URL or Staging Domain, HTTPS required)
STAGING_APP_URL=https://staging-api.your-domain.com

# Laravel Reverb WebSockets Credentials
STAGING_REVERB_APP_ID=
STAGING_REVERB_APP_KEY=
STAGING_REVERB_APP_SECRET=
STAGING_REVERB_PUBLIC_HOST=staging-api.your-domain.com

# Optional Staging Integrations (Sandbox/Test Credentials)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership
FCM_PROJECT_ID=
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
