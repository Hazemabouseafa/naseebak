APP_NAME="نصيبك - Naseebak"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=https://api.example.com
ADMIN_URL=https://admin.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL Database (Bound strictly to private interface 127.0.0.1 on VPS)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=naseebak_production
DB_USERNAME=naseebak_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=naseebak_cache_

# Google Sign-In OAuth / OpenID Connect Configuration (Server-side ID Token Verification)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Google Play Developer API for Server-Side Subscription Entitlement Verification
GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/etc/naseebak/credentials/google-play-service-account.json
GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership

# Firebase Cloud Messaging (FCM HTTP v1 ONLY — Push Notifications Only)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=/etc/naseebak/credentials/fcm-service-account.json

# Web Payment Gateways (Admin selects active gateway in DB: paymob | sha7nawy)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=

SHA7NAWY_BASE_URL=https://gate.sha7nawy.com
SHA7NAWY_API_KEY=
SHA7NAWY_MERCHANT_ID=
SHA7NAWY_WEBHOOK_SECRET=

# Laravel Reverb Real-time WebSocket Server (Authenticated Private Channels)
REVERB_APP_ID=naseebak-reverb-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="api.example.com"
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
