# ==============================================================================
# نصيبك (Naseebak) — Staging Environment Template (Isolated Coolify Environment)
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

APP_NAME="نصيبك (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://YOUR_STAGING_DOMAIN_HERE
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_DAYS=7
LOG_LEVEL=info
TRUSTED_PROXIES="*"

DB_CONNECTION=pgsql
DB_HOST=naseebak-staging-postgres
DB_PORT=5432
DB_DATABASE=naseebak_staging
DB_USERNAME=naseebak_staging_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=private
PRIVATE_STORAGE_ROOT=/var/www/html/storage/app/private

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_HOST=naseebak-staging-reverb
REVERB_PORT=8081
REVERB_SCHEME=http
STAGING_REVERB_PUBLIC_HOST=

GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership
FCM_PROJECT_ID=
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
