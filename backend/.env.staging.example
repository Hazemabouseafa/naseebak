# ==============================================================================
# نَصِيبُكَ (Naseebak) — Staging Environment Template (Isolated Coolify Environment)
# Location: backend/.env.staging.example
#
# Target Host: Hostinger VPS (187.126.13.178)
# Staging API: https://naseebak-api.hazem.my
# Staging WebSockets: wss://naseebak-ws.hazem.my
# Filament Admin: https://naseebak-api.hazem.my/admin
#
# DO NOT COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

APP_NAME="Naseebak"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://naseebak-api.hazem.my
ADMIN_URL=https://naseebak-api.hazem.my/admin
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_DAYS=7
LOG_LEVEL=info
TRUSTED_PROXIES="*"

# PostgreSQL Database (Internal Container Network: naseebak-staging-postgres)
DB_CONNECTION=pgsql
DB_HOST=naseebak-staging-postgres
DB_PORT=5432
DB_DATABASE=naseebak_staging
DB_USERNAME=naseebak_staging_user
DB_PASSWORD=

# Session, Cache & Queue Drivers (PostgreSQL-backed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Private Photo Storage
FILESYSTEM_DISK=private
PRIVATE_STORAGE_ROOT=/var/www/html/storage/app/private

# Laravel Reverb WebSockets
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_HOST=naseebak-staging-reverb
REVERB_PORT=8081
REVERB_SCHEME=http
STAGING_REVERB_PUBLIC_HOST=naseebak-ws.hazem.my
STAGING_REVERB_PUBLIC_SCHEME=https

# Official Google OAuth 2.0 Client IDs
GOOGLE_ANDROID_CLIENT_ID=520721691788-0fki6oqjcsjtk6g9qbo2ean3fj3cpeq2.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=520721691788-4ngp8rrm7g4foja1f3ql24bv2apdgcoo.apps.googleusercontent.com

# SMTP Transactional Email (Required for Account Deletion Verification Emails)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@hazem.my
MAIL_FROM_NAME="نَصِيبُكَ"

# Google Play Billing (com.naseebak.app)
GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/var/www/html/storage/app/private/google-play-service-account.json

# Firebase Cloud Messaging (Push Notifications ONLY)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=/var/www/html/storage/app/private/fcm-service-account.json

# Web Payment Gateway (Paymob Sandbox — Web Only)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=
