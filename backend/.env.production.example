# ==============================================================================
# نصيبك (Naseebak) — Production Environment Template (Coolify Secret Store)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# ==============================================================================

APP_NAME="نصيبك - Naseebak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://YOUR_PRODUCTION_DOMAIN_HERE
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAYS=14
LOG_LEVEL=warning

# Trusted Reverse Proxy (Coolify Traefik / Caddy)
TRUSTED_PROXIES="*"

# Dedicated Isolated PostgreSQL 16 Database (Internal Network Only)
DB_CONNECTION=pgsql
DB_HOST=naseebak-postgres
DB_PORT=5432
DB_DATABASE=naseebak_prod
DB_USERNAME=naseebak_user
DB_PASSWORD=

# Session, Cache & Queue Drivers (PostgreSQL-backed — Zero Redis Overhead)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Private Photo Storage Disk (Mounted Volume: naseebak_private_photos)
FILESYSTEM_DISK=private
PRIVATE_STORAGE_ROOT=/var/www/html/storage/app/private

# Laravel Reverb Real-Time WebSocket Server
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_HOST=naseebak-reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=

# Google Sign-In OpenID Connect Verification (Android & Web)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Google Play Billing & Real-Time Developer Notifications (RTDN)
GOOGLE_PLAY_PACKAGE_NAME=com.naseebak.app
GOOGLE_PLAY_MONTHLY_SUBSCRIPTION_ID=naseebak_monthly_membership
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/google-play-service-account.json
GOOGLE_PLAY_RTDN_OIDC_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Firebase Cloud Messaging (FCM HTTP v1 Push Notifications ONLY)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=/run/secrets/fcm-service-account.json

# Web Payment Gateways (Paymob Active by Default; Sha7nawy Standby)
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_IFRAME_ID=

SHA7NAWY_BASE_URL=https://gate.sha7nawy.com
SHA7NAWY_API_KEY=
SHA7NAWY_MERCHANT_ID=
SHA7NAWY_WEBHOOK_SECRET=

# Off-Server Encrypted Backup Configuration (S3-Compatible Object Storage)
BACKUP_DISK_DRIVER=s3
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_DEFAULT_REGION=eu-central-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_RETENTION_DAYS=14
