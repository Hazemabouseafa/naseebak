<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production & Staging default: strictly enforce HTTPS/WSS (disable cleartext HTTP/WS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
